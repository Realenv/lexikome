{
	"name": "lexikome",
	"compatibility_date": "2025-11-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
	},
	"observability": {
		"enabled": true
	},
	"previews": {},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "lexikome_db",
			"database_name": "lexikome-db",
			"database_id": "48a132da-0441-43a6-9ba9-b414abc864e0",
			"remote": true
		}
	]
}