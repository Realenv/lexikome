---
import Word from "../components/Word.astro";
const {word, learner_language, context_aware_meanings, language, category}: {
    word: string,
    learner_language: string,
    context_aware_meanings: string,
    language: string,
    category: string
} = await Astro.request.json();
export const partial = true;
---

<>
<Word word={word} context_aware_meanings={context_aware_meanings} language={language} category={category}/>
</>