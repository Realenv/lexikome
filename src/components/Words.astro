---
import Word from "./Word.astro";
import { get_words } from "../pages/words.json";
const entries = Astro.url.searchParams.entries().toArray();
const { page_count, words }: { page_count: number, words: {
    word: string;
    learner_language: string;
    context_aware_meanings: string;
    language: string;
    category: string;
}[] } = await get_words(entries);
---

<div id="container">
{words.map((word_data)=>{
    return <>
        <Word {...word_data} />
    </>
})}
</div>
<script is:inline>
function play_audio(sha){
    fetch("/get-audio.json", {
        method: "POST",
        body: JSON.stringify({
            sha: sha
        }),
        headers: {
            "Content-type": "application/json; charset=UTF-8"
        }
    }).then(async (response)=>{
        const audioSource = "data:audio/mp3;base64,"+(await response.json()).audio_data;
        const audio = new Audio();
        audio.src = audioSource;
        audio.play();
    });
}
</script>
<script>
const containers = document.getElementsByClassName("container");
let count: {[key: number]: number} = {};
function show_tense(p: number, children: HTMLCollection){
    for(let i = 0; i < children.length; i++){
            if(i != count[p]){
                children[i].setAttribute("style", "display:none");
            }
            
            else{
                children[i].setAttribute("style", "display:table");
            }
        }
}
for(let i = 0; i<containers.length; i++){
    const container = containers[i];
    let id_num = "getword-"+i;
    container.setAttribute("id", id_num)
    id_num = "#" + id_num;
    const previous = document.querySelector(id_num+" .previous")!;
    const next = document.querySelector(id_num+" .next")!;
    const conjugation = document.querySelector(id_num+" .conjugation")!;
    count[i] = 0;
    if(previous && next && conjugation){
        (previous as HTMLElement).onclick = () => {
            count[i]--;
            if (count[i] == -1){
                count[i] = conjugation.children.length - 1;
            }
            show_tense(i, conjugation.children);
        }
        (next as HTMLElement).onclick = () => {
            count[i]++;
            if (count[i] == conjugation.children.length){
                count[i] = 0;
            }
            show_tense(i, conjugation.children);
        }
    }
}
</script>
<style>
#container{
    display:flex;
    flex-wrap: wrap;
    justify-content: center;
    flex-grow:1;
}
</style>