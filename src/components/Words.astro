---
import Word from "./Word.astro";
import { get_words } from "../pages/words.json";
import "../styles/words.css";
const entries = Astro.url.searchParams.entries().toArray();
const { page_count, words }: { page_count: number, words: {
    word: string;
    learner_language: string;
    context_aware_meanings: string;
    language: string;
    category: string;
}[] } = await get_words(entries);
---
<>
    <h2>Pick the page number</h2>
    <div id="container">
    <div id="pagination_element" class="pagination">
    {
        Array.from({length: page_count}, (_, i) => i).map((i)=>(
            <button>{i}</button>
        ))
    }
    </div>
    {words.map((word_data, i)=>{
        return <Word i_word={i} {...word_data} />
    })}
    </div>
</>
<script>
import { reload_words } from "../scripts/reload_words";

const pagination = document.getElementById("pagination_element")!;
for(let i=0; i<pagination.children.length; i++){
    pagination.children[i].addEventListener("click", async ()=>{
        const url = new URL(window.location.href);
        url.searchParams.set("page", i.toString());
		let url_to_send = new URL("/words.json", window.location.origin);
		url.searchParams.forEach((value, key)=>{
			url_to_send.searchParams.set(key, value);
		});
		window.history.replaceState("", "", url);
		await reload_words(url_to_send);
    });
}
pagination.removeAttribute("id");
const pagination_bottom_page = pagination.cloneNode(true);
document.getElementById("container")!.appendChild(pagination_bottom_page);
</script>
<script is:inline>
function play_audio(sha){
    fetch("/get-audio.json", {
        method: "POST",
        body: JSON.stringify({
            sha: sha
        }),
        headers: {
            "Content-type": "application/json; charset=UTF-8"
        }
    }).then(async (response)=>{
        const audioSource = "data:audio/mp3;base64,"+(await response.json()).audio_data;
        const audio = new Audio();
        audio.src = audioSource;
        audio.play();
    });
}
</script>
<style>
h2{
    color:white;
    margin:0px;
    padding:15px 0px 0px 0px;
    font-size:15px;
    text-transform: uppercase;
    font-family: "lato", sans-serif;
    text-align: center;
    font-weight: 300;
}
</style>