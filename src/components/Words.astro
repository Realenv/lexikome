---
import Word from "./Word.astro";
import { get_words } from "../pages/words.json";
const entries = Astro.url.searchParams.entries().toArray();
const { page_count, words }: { page_count: number, words: {
    word: string;
    learner_language: string;
    context_aware_meanings: string;
    language: string;
    category: string;
}[] } = await get_words(entries);
---

<div id="container">
{words.map((word_data, i)=>{
    return <>
        <Word i_word={i} {...word_data} />
    </>
})}
</div>
<script is:inline>
function play_audio(sha){
    fetch("/get-audio.json", {
        method: "POST",
        body: JSON.stringify({
            sha: sha
        }),
        headers: {
            "Content-type": "application/json; charset=UTF-8"
        }
    }).then(async (response)=>{
        const audioSource = "data:audio/mp3;base64,"+(await response.json()).audio_data;
        const audio = new Audio();
        audio.src = audioSource;
        audio.play();
    });
}
</script>
<style>
#container{
    display:flex;
    flex-wrap: wrap;
    justify-content: center;
    flex-grow:1;
}
</style>