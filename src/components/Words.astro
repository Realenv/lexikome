---
import Word from "./Word.astro";

export const prerender = false;
import { env } from 'cloudflare:workers';

const result = await env.lexikome_db.prepare("SELECT * FROM words ORDER BY time_added ASC LIMIT 10 ").bind().all();
let listOfWords = [];
for(let i in result.results){
    const word = result.results[i];
    listOfWords.push({word: word["word"], audio: word["audio"], context_aware_meanings: word["context_aware_meanings"], language: word["language"]});
}
---

<div id="container">
{listOfWords.map((word_data)=>{
    return <Word {...word_data}/>
})}
</div>

<style>
#container{
    display:flex;
    flex-wrap: wrap;
    justify-content: center;
}
</style>