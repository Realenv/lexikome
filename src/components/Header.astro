---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import Search from '../assets/search.svg';
import RU from '../assets/ru.svg';
import AR from '../assets/ar.svg';
import TR from '../assets/tr.svg';
import EN from '../assets/us.svg';
import Lexikome from '../assets/lexikome.svg';
---

<div id="container">
	<header>
		<div class="hamburger">
			<div></div>
			<div class="middle_line"></div>
			<div></div>
		</div>
		<div>
			<Lexikome class={"lexikome"} height={25} width={111}/>
		</div>
		<div class="search">
			<input type="text" class="search_input"/>
			<div class="search_btn"><Search /></div>
		</div>
		<div class="train_btn">
			go to training
		</div>
	</header>
	<div class="subheader">
		<div class="choose_lang">
			<div>
				<label for="tr_lang"><TR width={18} class={"svg_lang"}/>tr</label>
				<input type="checkbox" id="tr_lang"/>
			</div>
			<div>
				<label for="en_lang"><EN width={18} class={"svg_lang"}/>en</label>
				<input type="checkbox" id="en_lang"/>
			</div>
			<div>
				<label for="ar_lang"><AR width={18} class={"svg_lang"}/>ar</label>
				<input type="checkbox" id="ar_lang"/>
			</div>
			<div>
				<label for="ru_lang"><RU width={18} class={"svg_lang"}/>ru</label>
				<input type="checkbox" id="ru_lang"/>
			</div>
		</div>
		<div class="select_last">

		</div>
	</div>
</div>

<style>
#container{
	display:flex;
	flex-direction: column;
}
header{
	padding: 15px 25px;
	display:flex;
	gap:25px;
	justify-content: space-between;
	align-items:center;
}
.subheader{
	display:flex;
	justify-content: space-around;
}
.subheader > .choose_lang{
	display:flex;
	gap: 5px;
}
.choose_lang div{
	display:flex;
	align-items: center;
	justify-content: center;
}
.choose_lang label{
	font-size: 15px;
	text-transform: uppercase;
	user-select: none;
	font-family: "Cantarell";
	display:flex;
	gap:2px;
}
.svg_lang{
	display:block;
	padding:0px;
	margin:0px;
}
.search{
	flex-grow: 1;
	display:flex;
	gap:9px;
	justify-content:center;
	align-items:center;
}
.hamburger{
	display:flex;
	flex-direction:column;
	justify-content:start;
	gap: 9px;
}
.hamburger div:not(.middle_line){
	background-color: black;
	height: 2px;
	width: 35px;
}
.middle_line{
	background-color: black;
	height: 2px;
	width: 25px;
}
.search_input{
	background: #eee;
	border:0px solid black;
	border-radius: 15px;
	padding:9px 15px;
	font-size: 15px;
	outline: none;
}
.search_input:focus{
	outline-width: 1px;
	outline-color: gray;
	outline-offset: 0px;
	outline-style: solid;
}
.search_btn{
	border-radius: 15px;
	display:flex;
	justify-content: center;
	padding:5px;
	align-items: center;
	font-size: 15px;
	text-transform: uppercase;
	font-family:"Cantarell", sans-serif;
	font-weight: 100;
}
.train_btn{
	border: 1px solid black;
	border-radius:7px;
	color:black;
	display:flex;
	justify-content: center;
	align-items: center;
	padding:5px 15px;
	font-family:"Cantarell", sans-serif;
	text-transform: capitalize;
}
	.lexikome{
		display:none;
	}
	div:has(>.lexikome){
		display:flex;
		justify-content: center;
		align-items: center;
	}
@media (width > 650px) {
	.hamburger{
		display:none;
	}
	.lexikome{
		display:block;
	}
	header{
		justify-content: center;
	}
}
</style>
