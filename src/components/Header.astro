---
import Search from '../assets/search.svg';
import RU from '../assets/ru.svg';
import AR from '../assets/ar.svg';
import TR from '../assets/tr.svg';
import EN from '../assets/us.svg';
import Close from '../assets/close.svg';
---

<div id="container">
	<header>
		<div class="hamburger">
			<div></div>
			<div class="middle_line"></div>
			<div></div>
		</div>
		<div>
			<div class="lexikome">
				<span class="lexi">Lexi</span>
				<span class="kome">Kome</span>
			</div>
		</div>
		<div style="position:relative; flex-grow:1;">
			<div class="search">
				<div id="close"><Close/></div>
				<input type="text" id="search_input"/>
				<div id="search_btn"><Search /></div>
			</div>
		</div>
		<div id="train_btn">
			Train
		</div>
	</header>
	<div class="subheader">
		<div class="pick_lang">
			<h2>Pick some languages:</h2>
			<div class="choose_lang">
				<div>
					<label for="tr_lang"><TR width={18} class={"svg_lang"}/>tr</label>
					<input type="checkbox" id="tr_lang" checked/>
				</div>
				<div>
					<label for="en_lang"><EN width={18} class={"svg_lang"}/>en</label>
					<input type="checkbox" id="en_lang" checked/>
				</div>
				<div>
					<label for="ar_lang"><AR width={18} class={"svg_lang"}/>ar</label>
					<input type="checkbox" id="ar_lang" checked/>
				</div>
				<div>
					<label for="ru_lang"><RU width={18} class={"svg_lang"}/>ru</label>
					<input type="checkbox" id="ru_lang" checked/>
				</div>
			</div>
		</div>
		<div class="select_last">

		</div>
	</div>
</div>
<script>
const search_btn = document.getElementById("search_btn");
const close = document.getElementById("close");
const search_input = document.getElementById("search_input");
if (search_btn && search_input && close){
	search_btn.onclick = ()=>{
		search_input.classList.add("user_search");
	};
	close.onclick = ()=>{
		search_input.classList.remove("user_search");
	};
}
</script>
<style>
*{
	padding:0px;
	margin:0px;
}
#search_input{
	background: hsl(var(--hue), 70%, 60%);
	border:0px solid black;
	border-radius: 15px;
	max-width: 555px;
	padding:9px 15px;
	font-size: 15px;
	outline: none;
	flex-grow:1;
	display:none;
	color:white;
}
:root{
	--hue:222
}
#close{
	display:none;
}
.lexi{
	color: black;
	text-shadow: hsl(var(--hue), 100%, 90%) 0px 5px 15px;
}
.pick_lang{
	display:flex;
	flex-direction:column;
}
.pick_lang > h2{
	font-weight: 100;
	font-family: "Cantarell", sans-serif;
	font-size: 13px;
	text-transform: uppercase;

	color:black;
}
.choose_lang{
	display:flex;
	flex-direction:row;
	gap: 5px;
}
.kome{
	color: white;
	text-shadow: hsl(var(--hue), 100%, 10%) 0px -5px 15px;
}
.lexikome{
	display:none;
	font-family:"Cantarell", sans-serif;
	font-weight: 900;
	font-size: 19px;
	transition:1s all;
}
.lexikome:hover{
	filter:contrast(200%) brightness(200%)
}
div:has(>.lexikome){
	display:flex;
	justify-content: center;
	align-items: center;
}
#container{
	display:flex;
	flex-direction: column;
	background: hsl(var(--hue), 50%, 50%);
	padding-bottom: 15px;
}
header{
	padding: 15px 25px;
	display:flex;
	gap:25px;
	justify-content: space-between;
	align-items:center;
}
.subheader{
	display:flex;
	justify-content: space-around;
}
.choose_lang div:has(input){
	color: hsl(0, 0%, 80%);
}
.choose_lang div:has(input:checked){
	color: hsl(0, 0%, 100%);
}
.choose_lang div input{
	display:none;
}
.choose_lang div:has(input) .svg_lang{
	opacity:75%;
	filter: brightness(50%)
}
.choose_lang div:has(input:checked) .svg_lang{
	opacity:100%;
	filter: brightness(100%)
}
.choose_lang div{
	display:flex;
	align-items: center;
	justify-content: center;
}
.choose_lang label{
	font-size: 15px;
	text-transform: uppercase;
	user-select: none;
	font-family: "Cantarell";
	display:flex;
	gap:2px;
}
.svg_lang{
	display:block;
	padding:0px;
	margin:0px;
}
.search{
	flex-grow: 1;
	display:flex;
	gap:9px;
	justify-content:center;
	align-items:center;
}
.hamburger{
	display:flex;
	flex-direction:column;
	justify-content:start;
	gap: 9px;
}
.hamburger div:not(.middle_line){
	background-color: black;
	height: 2px;
	width: 35px;
}
.middle_line{
	background-color: black;
	height: 2px;
	width: 25px;
}
#search_input:focus{
	outline-width: 1px;
	outline-color: gray;
	outline-offset: 0px;
	outline-style: solid;
}
#search_btn{
	display:flex;
	justify-content: center;
	padding:5px;
	align-items: center;
}

#train_btn{
	border-radius:2px;
	background:hsl(var(--hue), 100%, 70%);
	box-shadow: 0px 5px 15px 1px hsl(var(--hue), 50%, 52%);
	color:#eee;
	text-transform: uppercase;
	display:flex;
	letter-spacing: -1px;
	justify-content: center;
	align-items: center;
	padding:5px 15px;
	font-family:"Cantarell", sans-serif;
}
@media (width > 650px) {
	.hamburger{
		display:none;
	}
	.lexikome{
		display:block;
	}
	#search_input{
		display: block;
	}
	header{
		justify-content: center;
	}
	.search{
		padding: 0px 25px;
	}
	.pick_lang{
		flex-direction: row;
		align-items: center;
		gap:15px;
	}
}
@media (width <= 650px) {
	.user_search{
		display: block !important;
		padding-right:45px !important;
	}
	.search:has(> .user_search) #close{
		position:absolute;
		top:21px;
		right:15px;
		display:block;
	}
	.search:has(> .user_search){
		position:fixed;
		width: 100vw;
		top:0px;
		left:0px;
		padding:15px 45px 15px 25px;
		box-sizing: border-box;
		background-color: hsl(var(--hue), 50%, 50%);
	}
	.search:has(> .user_search) #search_btn{
		position:absolute;
		top:15px;
		right:49px;
	}
}
</style>
