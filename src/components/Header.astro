---

const {show_subheader} = Astro.props;
import Search from '../assets/search.svg';
import RU from '../assets/ru.svg';
import AR from '../assets/ar.svg';
import TR from '../assets/tr.svg';
import EN from '../assets/us.svg';
import FR from '../assets/fr.svg';
import Close from '../assets/close.svg';
---

<div id="header">
	<header>
		<div>
			<a class="lexikome" href="/">
				<span class="lexi">Lexi</span>
				<span class="kome">Kome</span>
			</a>
		</div>
		<div style="position:relative; flex-grow:1;">
			<div class="search">
				<div id="close"><Close style={"filter:invert(1)"}/></div>
				<input type="text" id="search_input"/>
				<div id="search_btn"><Search style={"filter:invert(1)"}/></div>
			</div>
		</div>
		<a href="/add-word" id="addword_btn">
			Add word
		</a>
		<a href="/train" id="train_btn">
			Train
		</a>
	</header>
	{show_subheader == "true" && <div class="subheader">
		<div class="pick_lang">
			<h2>Pick word's language:</h2>
			<div class="choose_lang">
				<div>
					<label for="tr_lang"><TR width={18} class={"svg_lang"}/>tr</label>
					<input type="checkbox" id="tr_lang" />
				</div>
				<div>
					<label for="en_lang"><EN width={18} class={"svg_lang"}/>en</label>
					<input type="checkbox" id="en_lang" />
				</div>
				<div>
					<label for="ar_lang"><AR width={18} class={"svg_lang"}/>ar</label>
					<input type="checkbox" id="ar_lang" />
				</div>
				<div>
					<label for="ru_lang"><RU width={18} class={"svg_lang"}/>ru</label>
					<input type="checkbox" id="ru_lang" />
				</div>
				<div>
					<label for="fr_lang"><FR width={18} class={"svg_lang"}/>fr</label>
					<input type="checkbox" id="fr_lang" />
				</div>
			</div>
		</div>
		<div class="pick_lang">
			<h2>Pick your language:</h2>
			<div class="choose_lang">
				<div>
					<label for="tr_lang_l"><TR width={18} class={"svg_lang"}/>tr</label>
					<input type="checkbox" id="tr_lang_l" />
				</div>
				<div>
					<label for="en_lang_l"><EN width={18} class={"svg_lang"}/>en</label>
					<input type="checkbox" id="en_lang_l" />
				</div>
				<div>
					<label for="ar_lang_l"><AR width={18} class={"svg_lang"}/>ar</label>
					<input type="checkbox" id="ar_lang_l" />
				</div>
				<div>
					<label for="ru_lang_l"><RU width={18} class={"svg_lang"}/>ru</label>
					<input type="checkbox" id="ru_lang_l" />
				</div>
				<div>
					<label for="fr_lang_l"><FR width={18} class={"svg_lang"}/>fr</label>
					<input type="checkbox" id="fr_lang_l" />
				</div>
			</div>
		</div>
	</div>}
</div>
<script>
import { reload_words } from "../scripts/reload_words";
const search_btn = document.getElementById("search_btn");
const close = document.getElementById("close");
const search_input = document.getElementById("search_input");
if (search_btn && search_input && close){
	search_btn.onclick = ()=>{
		search_input.classList.add("user_search");
	};
	close.onclick = ()=>{
		search_input.classList.remove("user_search");
	};
}

if(document.getElementsByClassName("subheader").length != 0){
	const en_lang = document.getElementById("en_lang")!;
	const tr_lang = document.getElementById("tr_lang")!;
	const ar_lang = document.getElementById("ar_lang")!;
	const ru_lang = document.getElementById("ru_lang")!;
	const fr_lang = document.getElementById("fr_lang")!;
	const en_lang_l = document.getElementById("en_lang_l")!;
	const tr_lang_l = document.getElementById("tr_lang_l")!;
	const ar_lang_l = document.getElementById("ar_lang_l")!;
	const ru_lang_l = document.getElementById("ru_lang_l")!;
	const fr_lang_l = document.getElementById("fr_lang_l")!;

	const matching: {[key: string]: HTMLInputElement} = {
		"english": en_lang as HTMLInputElement,
		"turkish": tr_lang as HTMLInputElement,
		"arabic": ar_lang as HTMLInputElement,
		"russian": ru_lang as HTMLInputElement,
		"french": fr_lang as HTMLInputElement
	}

	const matching_learner: {[key: string]: HTMLInputElement} = {
		"english_l": en_lang_l as HTMLInputElement,
		"turkish_l": tr_lang_l as HTMLInputElement,
		"arabic_l": ar_lang_l as HTMLInputElement,
		"russian_l": ru_lang_l as HTMLInputElement,
		"french_l": fr_lang_l as HTMLInputElement
	}

	const url = new URL(window.location.href);

	for(const [key, value] of Object.entries(matching)){
		if (url.searchParams.has(key)){
			value.checked = url.searchParams.get(key) != "false";
		} else{
			value.checked = true;
		}
		value.onchange = async ()=>{
			url.searchParams.delete(key);
			if (value.checked == false){
				url.searchParams.append(key, "false");
			}
			url.searchParams.delete("page");
			let url_to_send = new URL("/words.json", window.location.origin);
			url.searchParams.forEach((value, key)=>{
				url_to_send.searchParams.set(key, value);
			});
			window.history.replaceState("", "", url);
			await reload_words(url_to_send);
		}
	};
	for(const [key, value] of Object.entries(matching_learner)){
		if (url.searchParams.has(key)){
			value.checked = url.searchParams.get(key) != "false";
		} else{
			value.checked = true;
		}
		value.onchange = async ()=>{
			url.searchParams.delete(key);
			if (value.checked == false){
				url.searchParams.append(key, "false");
			}
			url.searchParams.delete("page");
			let url_to_send = new URL("/words.json", window.location.origin);
			url.searchParams.forEach((value, key)=>{
				url_to_send.searchParams.set(key, value);
			});
			window.history.replaceState("", "", url);
			await reload_words(url_to_send);
		}
	};
}
</script>
<style>
*{
	padding:0px;
	margin:0px;
}
#search_input{
	background: hsl(var(--hue), 70%, 60%);
	border:0px solid black;
	border-radius: 15px;
	max-width: 555px;
	padding:9px 15px;
	font-size: 15px;
	outline: none;
	flex-grow:1;
	display:none;
	color:white;
}
#close{
	display:none;
}
.lexi{
	color: black;
	text-shadow: hsl(var(--hue), 100%, 90%) 0px 5px 15px;
}
.pick_lang{
	display:flex;
	flex-direction:column;
}
.pick_lang > h2{
	font-weight: 300;
	font-family:"lato", sans-serif;
	font-size: 13px;
	text-transform: uppercase;
	color:white;
}
.choose_lang{
	display:flex;
	flex-direction:row;
	gap: 5px;
}
.kome{
	color: white;
	text-shadow: hsl(var(--hue), 100%, 10%) 0px -5px 15px;
}
.lexikome{
	font-family:"lato", sans-serif;
	font-weight: 900;
	font-size: 25px;
	display:block;
	text-decoration: none;
	font-style: italic;
	transition:1s all;
}
.lexikome:hover{
	filter:contrast(200%) brightness(200%)
}
div:has(>.lexikome){
	display:flex;
	justify-content: center;
	align-items: center;
}
#header{
	display:flex;
	flex-direction: column;
	background: hsl(var(--hue), 63%, 46%);
	box-shadow: 0px 0px 25px 25px hsl(var(--hue), 63%, 46%);
}
header{
	padding: 15px 5vw 9px 5vw;
	display:flex;
	flex-wrap:wrap;
	gap:5px 25px;
	justify-content:end;
}
.subheader{
	display:flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 5px 15px;
	padding: 0px 15px;
}
.choose_lang div:has(input){
	color: hsl(0, 0%, 80%);
}
.choose_lang div:has(input:checked){
	color: hsl(0, 0%, 100%);
}
.choose_lang div input{
	display:none;
}
.choose_lang div:has(input) .svg_lang{
	opacity:75%;
	filter: brightness(50%)
}
.choose_lang div:has(input:checked) .svg_lang{
	opacity:100%;
	filter: brightness(100%)
}
.choose_lang div{
	display:flex;
	align-items: center;
	justify-content: center;
}
.choose_lang label{
	font-size: 15px;
	text-transform: uppercase;
	user-select: none;
	font-family:"lato", sans-serif;
	font-weight: 900;
	display:flex;
	gap:2px;
}
.svg_lang{
	display:block;
	padding:0px;
	margin:0px;
}
.search{
	flex-grow: 1;
	display:flex;
	gap:9px;
	justify-content:center;
	align-items:center;
}
#search_input:focus{
	outline-width: 1px;
	outline-color: gray;
	outline-offset: 0px;
	outline-style: solid;
}
#search_btn{
	display:flex;
	justify-content: center;
	padding:5px;
	align-items: center;
}
#train_btn{
	background:hsl(var(--hue), 100%, 70%);
}
#addword_btn{
	border:1px solid hsl(var(--hue), 100%, 70%);
}
#addword_btn, #train_btn{
	border-radius:2px;
	text-decoration: none;
	font-style: normal;
	color:#eee;
	text-transform: uppercase;
	display:flex;
	letter-spacing: -1px;
	justify-content: center;
	align-items: center;
	padding:5px 15px;
	font-family:"lato", sans-serif;
	font-weight: 300;
	transition: 200ms all;
	box-shadow: 0px 5px 15px 1px hsl(var(--hue), 50%, 52%);
}
#addword_btn:hover, #train_btn:hover{
	filter:brightness(125%)
}
#addword_btn:active, #train_btn:active{
	filter:brightness(75%)
}
@media (width > 650px) {
	#search_input{
		display: block;
	}
	header{
		padding: 15px 7vw 9px 7vw;
	}
	.search{
		padding: 0px 25px;
	}
	.pick_lang{
		flex-direction: row;
		align-items: center;
		gap:15px;
	}
}
@media (width <= 650px) {
	.user_search{
		display: block !important;
		padding-right:45px !important;
	}
	.search:has(> .user_search) #close{
		position:absolute;
		top:21px;
		right:15px;
		display:block;
	}
	.search:has(> .user_search){
		position:fixed;
		width: 100vw;
		top:0px;
		left:0px;
		padding:15px 45px 15px 25px;
		box-sizing: border-box;
		background-color: hsl(var(--hue), 50%, 50%);
	}
	.search:has(> .user_search) #search_btn{
		position:absolute;
		top:15px;
		right:49px;
	}
}
</style>
