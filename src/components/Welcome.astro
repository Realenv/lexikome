---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import Search from '../assets/search.svg';
---

<div id="container">
	<header>
		<div class="hamburger">
			<div></div>
			<div class="middle_line"></div>
			<div></div>
		</div>
		<div class="search">
			<input type="text" class="search_input"/>
			<div class="search_btn"><Search /></div>
		</div>
		<div class="train_btn">
			go to training
		</div>
	</header>
</div>

<style>
header{
	padding: 15px 25px;
	display:flex;
	gap:25px;
	justify-content: space-between;
	align-items:center;
}
.search{
	flex-grow: 1;
	display:flex;
	gap:9px;
	justify-content:center;
	align-items:center;
}
.hamburger{
	display:flex;
	flex-direction:column;
	justify-content:start;
	gap: 9px;
}
.hamburger div:not(.middle_line){
	background-color: black;
	height: 2px;
	width: 35px;
}
.middle_line{
	background-color: black;
	height: 2px;
	width: 25px;
}
.search_input{
	background: #eee;
	border:0px solid black;
	border-radius: 15px;
	padding:9px;
	font-size: 15px;
}
.search_btn{
	border-radius: 15px;
	display:flex;
	justify-content: center;
	padding:5px;
	align-items: center;
	font-size: 15px;
	text-transform: uppercase;
	font-family:"Cantarell", sans-serif;
	font-weight: 100;
}
.train_btn{
	border: 1px solid black;
	border-radius:7px;
	color:black;
	display:flex;
	justify-content: center;
	align-items: center;
	padding:5px 15px;
	font-family:"Cantarell", sans-serif;
	text-transform: capitalize;
}
</style>
