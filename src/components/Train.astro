---
import RU from '../assets/ru.svg';
import AR from '../assets/ar.svg';
import TR from '../assets/tr.svg';
import EN from '../assets/us.svg';
import FR from '../assets/fr.svg';

const preferred_lang = Astro.cookies.get("preferred_lang")?.value ?? "english";
---
<div>
    <div class="select_cat">
        <h2>Select the categories</h2>
        <div>
            <label for="search_cat">Search a category</label>
            <div>
                <input type="search" id="search_cat"/>
                <div id="prediction_cat"> </div>
            </div>
        </div>
        <div>
            <label for="num_cat">Select X number of words</label>
            <input type="number" id="num_cat" min="0" max="25" value="5"/>
        </div>
        <div>
            <label for="difficulty">Select difficulty</label>
            <select id="difficulty">
                <option value="easy">Easy</option>
                <option value="medium">Medium</option>
                <option value="hard">Hard</option>
            </select>
        </div>
        <div>
            <div class="pick_lang">
                <h2>Pick word's language:</h2>
                <div class="choose_lang">
                    <div>
                        <label for="tr_lang"><TR width={18} class={"svg_lang"}/>tr</label>
                        <input type="checkbox" id="tr_lang" checked/>
                    </div>
                    <div>
                        <label for="en_lang"><EN width={18} class={"svg_lang"}/>en</label>
                        <input type="checkbox" id="en_lang" checked/>
                    </div>
                    <div>
                        <label for="ar_lang"><AR width={18} class={"svg_lang"}/>ar</label>
                        <input type="checkbox" id="ar_lang" checked/>
                    </div>
                    <div>
                        <label for="ru_lang"><RU width={18} class={"svg_lang"}/>ru</label>
                        <input type="checkbox" id="ru_lang" checked/>
                    </div>
                    <div>
                        <label for="fr_lang"><FR width={18} class={"svg_lang"}/>fr</label>
                        <input type="checkbox" id="fr_lang" checked/>
                    </div>
                </div>
            </div>
            <div class="pick_lang">
                <h2>Pick your language:</h2>
                <div class="choose_lang">
                    <div>
                        <label for="tr_lang_l"><TR width={18} id="tr_svg" class={"svg_lang"}/>tr</label>
                        {
                            preferred_lang == "turkish" ? <input type="checkbox" id="tr_lang_l" checked/> : <input type="checkbox" id="tr_lang_l" />
                        }
                    </div>
                    <div>
                        <label for="en_lang_l"><EN width={18} id="en_svg" class={"svg_lang"}/>en</label>
                        {
                            preferred_lang == "english" ? <input type="checkbox" id="en_lang_l" checked/> : <input type="checkbox" id="en_lang_l" />
                        }
                    </div>
                    <div>
                        <label for="ar_lang_l"><AR width={18} id="ar_svg" class={"svg_lang"}/>ar</label>
                        {
                            preferred_lang == "arabic" ? <input type="checkbox" id="ar_lang_l" checked/> : <input type="checkbox" id="ar_lang_l" />
                        }
                    </div>
                    <div>
                        <label for="ru_lang_l"><RU width={18} id="ru_svg" class={"svg_lang"}/>ru</label>
                        {
                            preferred_lang == "russian" ? <input type="checkbox" id="ru_lang_l" checked/> : <input type="checkbox" id="ru_lang_l" />
                        }
                    </div>
                    <div>
                        <label for="fr_lang_l"><FR width={18} id="tr_svg" class={"svg_lang"}/>fr</label>
                        {
                            preferred_lang == "french" ? <input type="checkbox" id="fr_lang_l" checked/> : <input type="checkbox" id="fr_lang_l" />
                        }
                    </div>
                </div>
            </div>
        </div>
        <h2>Select individual words</h2>
        <div>
            <label for="search_word">Search a word</label>
            <div>
                <input type="search" id="search_word"/>
                <div id="prediction_word"> </div>
            </div>
        </div>
        <div style="justify-content:end">
            <button id="gotrain">Go training</button>
        </div>
    </div>
</div>
<script>
const search_word = document.getElementById("search_word")!;
const predictions = document.getElementById("prediction_word")!;
const en_lang = document.getElementById("en_lang")! as HTMLInputElement;
const tr_lang = document.getElementById("tr_lang")! as HTMLInputElement;
const ar_lang = document.getElementById("ar_lang")! as HTMLInputElement;
const ru_lang = document.getElementById("ru_lang")! as HTMLInputElement;
const fr_lang = document.getElementById("fr_lang")! as HTMLInputElement;
const en_lang_l = document.getElementById("en_lang_l")! as HTMLInputElement;
const tr_lang_l = document.getElementById("tr_lang_l")! as HTMLInputElement;
const ar_lang_l = document.getElementById("ar_lang_l")! as HTMLInputElement;
const ru_lang_l = document.getElementById("ru_lang_l")! as HTMLInputElement;
const fr_lang_l = document.getElementById("fr_lang_l")! as HTMLInputElement;


let num_pred = 0;
const search_word_pred = async () => {
    await get_prediction(
        num_pred,
         (search_word as HTMLInputElement).value
    )
};
const onchange_fn = async ()=>{
    await search_word_pred();
};
en_lang.onchange = onchange_fn;
tr_lang.onchange = onchange_fn;
ar_lang.onchange = onchange_fn;
ru_lang.onchange = onchange_fn;
fr_lang.onchange = onchange_fn;
en_lang_l.onchange = onchange_fn;
tr_lang_l.onchange = onchange_fn;
ar_lang_l.onchange = onchange_fn;
ru_lang_l.onchange = onchange_fn;
fr_lang_l.onchange = onchange_fn;

const matching_ids: {[key: string]: string} = {
    "english": "en_svg",
    "turkish": "tr_svg",
    "arabic": "ar_svg",
    "russian": "ru_svg",
    "french": "fr_svg"
}

function getAllWordLanguages(){
    let languages = [];
    if(en_lang.checked){
        languages.push("english");
    }
    if(ar_lang.checked){
        languages.push("arabic");
    }
    if(ru_lang.checked){
        languages.push("russian");
    }
    if(tr_lang.checked){
        languages.push("turkish");
    }
    if(fr_lang.checked){
        languages.push("french");
    }
    return languages
}
function getAllLearnerLanguages(){
    let languages = [];
    if(en_lang_l.checked){
        languages.push("english");
    }
    if(ar_lang_l.checked){
        languages.push("arabic");
    }
    if(ru_lang_l.checked){
        languages.push("russian");
    }
    if(tr_lang_l.checked){
        languages.push("turkish");
    }
    if(fr_lang_l.checked){
        languages.push("french");
    }
    return languages
}
async function get_prediction(num: number, to_search: string, removeWords: boolean = true){
    const response = await fetch("/predict.json", {
        method: "POST",
        body: JSON.stringify({
            to_search: to_search,
            num: num,
            lang: getAllWordLanguages(),
            lang_l: getAllLearnerLanguages(),
            categories: ["realenv"]
        }),
        headers: {
            "Content-type": "application/json; charset=UTF-8"
        }
    });
    const result: { message: string,
        error: boolean,
        error_source: string,
        predictions: Record<string, unknown>[] | null,
        count: number } = await response.json();
    console.log(result);
    if(result.predictions){
        if(removeWords){
            predictions.innerHTML = "";
        }
        for(const pred of result.predictions){
            const div = document.createElement("div");
            div.style.display = "flex";
            div.style.justifyContent = "space-between";
            div.style.gap = "11px";
            div.style.padding = "5px 15px";

            const flag = document.getElementById(matching_ids[pred.language as string])!.cloneNode(true);
            (flag as HTMLElement).removeAttribute("id");
            div.appendChild(flag);

            const divWord = document.createElement("div");
            divWord.innerHTML = pred.word as string;
            div.appendChild(divWord);

            const divCat = document.createElement("div");
            divCat.classList.add("cat_div");
            divCat.style.background = "#0001";
            divCat.style.border = "1px solid #4449";
            divCat.style.color = "#9999";
            divCat.style.borderRadius = "15px";
            divCat.style.padding = "2px 11px";
            divCat.innerHTML = pred.category as string;
            div.appendChild(divCat);

            predictions.appendChild(div);
        }
        if(num_pred*5 <= result.count && result.count != 0){
            const other = document.createElement("div");
            other.innerHTML = "show more";
            other.onclick = async ()=>{
                num_pred += 1;
                await get_prediction(num_pred, (search_word as HTMLInputElement).value, false);
            }
            predictions.appendChild(other);
        }
        return predictions;
    } else{
        return "";
    }
}

let timeout: NodeJS.Timeout;
search_word.oninput = ()=>{
    clearTimeout(timeout);
    timeout = setTimeout(search_word_pred, 250);
}
</script>
<style>
*{
    padding:0px;
    margin:0px;
}
#search_word{
    flex-grow: 1;
}
div:has(>#prediction_cat), div:has(>#prediction_word){
    display:grid;
    grid-template-columns: 1fr;
    flex-grow: 1;
    grid-template-rows: auto auto;
}
div:has(>.select_cat){
    display:flex;
    justify-content: center;
}
.select_cat{
    display:flex;
    flex-direction:column;
    gap: 15px;
    background-color: hsl(var(--hue), 50%, 15%);
    color: #ddd;
    max-width: 455px;
    margin: 15px;
	font-family:"lato", sans-serif;
    padding:15px;
    box-sizing: border-box;
    box-shadow: 0px 5px 11px 11px hsla(var(--hue), 50%, 20%, 0.1);
}
.select_cat h2{
    color: hsl(var(--hue), 75%, 75%);
    text-transform: uppercase;
    font-size:15px;
    font-weight: 300;
    user-select: none;
    padding:0px 5px;
}
.select_cat > *{
    display: flex;
    justify-content: space-between;
    gap:5px 15px;
}
@media (width < 400px) {
    .select_cat > *{
        flex-direction: column;
    }
}
.select_cat button{
    background:hsl(170, 100%, 40%);
    padding: 5px 15px;
    border-radius: 2px;
    border:none;
    color:black;
    font-family: "lato", sans-serif;
    text-transform: uppercase;
    transition: 200ms all;
    box-shadow: 0px 3px 15px 1px hsla(var(--hue), 50%, 50%, 0.3);
}
.select_cat button:hover{
    filter:brightness(135%);
}
.select_cat button:active{
    filter:brightness(75%);
}
label, input{
	font-family:"lato", sans-serif;
}
input, select{
    border:none;
    color:white;
    background-color: hsl(var(--hue), 50%, 25%);
    padding:5px 15px 5px 15px;
    color-scheme: dark;
    outline:none;
    box-shadow:0px 0px 5px 1px #0002;
    transition: 100ms all;
}
input:hover, select:hover{
    filter:brightness(110%);
}
input:focus, select:focus{
    filter:brightness(90%);
}
.pick_lang{
	display:flex;
	flex-direction:column;
}
.choose_lang{
	display:flex;
	flex-direction:row;
    flex-wrap: wrap;
	gap: 5px;
}
.choose_lang div:has(input){
	color: hsl(0, 0%, 80%);
}
.choose_lang div:has(input:checked){
	color: hsl(0, 0%, 100%);
}
.choose_lang div input{
	display:none;
}
.choose_lang div:has(input) .svg_lang{
	opacity:75%;
	filter: brightness(50%)
}
.choose_lang div:has(input:checked) .svg_lang{
	opacity:100%;
	filter: brightness(100%)
}
.choose_lang div{
	display:flex;
	align-items: center;
	justify-content: center;
}
.choose_lang label{
	font-size: 15px;
	text-transform: uppercase;
	user-select: none;
	font-family:"lato", sans-serif;
	font-weight: 900;
	display:flex;
	gap:2px;
}
.svg_lang{
	display:block;
	padding:0px;
	margin:0px;
}
#prediction_cat, #prediction_word{
    background:hsl(var(--hue), 50%, 7%);
    color:hsl(var(--hue), 50%, 50%);
    padding:3px 6px;
    display: flex;
    flex-direction: column;
    box-shadow: 0px 5px 15px 3px #0002;
    border-radius:2px;
    font-family:'lato', sans-serif;
    gap:5px;
}
</style>