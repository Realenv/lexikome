<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cantarell:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap');

*{
	padding:0px;
	margin:0px;
}
:root{
	--hue:222
}
body {
	max-width: 100vw;
	min-height: 100vh;
	background: hsl(var(--hue), 63%, 35%);
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	justify-content: space-between;
}
</style>
<script>
async function reload_words(entries: [string, string][]){
    const { page_count, words }: {page_count: number, words: any} = await (await fetch("/words.json", {
        method: "GET",
        body: JSON.stringify({
            entries: entries
        }),
        headers: {
            "Content-type": "application/json; charset=UTF-8"
        }
    })).json();
    const container = document.getElementById("container")!;
    const url = new URL("/word");
    url.searchParams.append("word", words["word"]);
    url.searchParams.append("context_aware_meanings", words["context_aware_meanings"]);
    url.searchParams.append("category", words["category"]);
    url.searchParams.append("language", words["language"]);
    container.innerHTML = await (await fetch(url.href)).text();
}
</script>